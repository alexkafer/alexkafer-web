{
  "name": "alexkafer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/generate-build-info.mjs && NEXT_PUBLIC_BUILD_SHA=$(git rev-parse --short HEAD 2>/dev/null || echo dev) NEXT_PUBLIC_BUILD_TIME=$(date -u +%Y-%m-%dT%H:%M:%SZ) next build",
    "start": "next start",
    "lint": "next lint",
    "test:dev": "node --test scripts/*.test.mjs",
    "test:labs": "rm -rf /tmp/alexkafer-labs-tests && tsc --module commonjs --moduleResolution node --target es2022 --lib es2022,dom --esModuleInterop --skipLibCheck --strict --noEmit false --outDir /tmp/alexkafer-labs-tests src/lib/labs/*.test.ts && node --test /tmp/alexkafer-labs-tests/*.test.js",
    "demos:refresh": "node scripts/refresh-demos.mjs",
    "db:migrate:local": "wrangler d1 migrations apply alexkafer-ab --local",
    "db:migrate:remote": "wrangler d1 migrations apply alexkafer-ab --remote",
    "cf:build": "node scripts/generate-build-info.mjs && opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@libsql/client": "^0.17.3",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "lucide-react": "^1.11.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.14.10",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/three": "^0.184.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wrangler": "^4.85.0"
  }
}
